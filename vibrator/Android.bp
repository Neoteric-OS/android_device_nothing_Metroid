package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.vibrator-service.nothing",
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.nothing.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.nothing.xml"],
    vendor: true,
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    local_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "libcutils",
        "android.hardware.vibrator-V4-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
}
